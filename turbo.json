{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  
  "globalEnv": [
    "DATABASE_URL",
    "FRONTEND_URL",
    "JWT_SECRET",
    "COOKIE_SAME_SITE"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": true
    }
  }
}
